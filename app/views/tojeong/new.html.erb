<%
  faqs = [
    {
      question: "무료 토정비결은 무엇을 보나요?",
      answer: "한 해의 전체 흐름, 월별 분위기, 재물과 관계의 큰 방향을 참고용으로 정리해볼 수 있습니다."
    },
    {
      question: "연간 운세와 토정비결은 어떻게 다른가요?",
      answer: "연간 운세가 현재 사주 흐름에 초점을 두면, 토정비결은 한 해를 길게 읽는 전통적인 참고형 콘텐츠에 가깝습니다."
    },
    {
      question: "태어난 시간이 꼭 필요한가요?",
      answer: "시간까지 입력하면 더 자연스럽게 흐름을 읽을 수 있지만, 기본 확인은 가까운 시간대로도 가능합니다."
    }
  ]
%>
<% content_for(:title) { "무료 토정비결 보기 | 1분 사주" } %>
<% content_for(:description) { "무료 토정비결로 올해의 큰 흐름을 확인해보세요. 생년월일시 입력 후 연간 분위기와 월별 흐름을 빠르게 읽어볼 수 있습니다." } %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw faq_schema_json(faqs) %></script>
<% end %>

<div class="page-header animate-fadeIn">
  <%= image_tag "logo_1min_saju.png", class: "snowcat-mascot", alt: "1분 사주" %>
  <h1>무료 토정비결</h1>
  <p class="subtitle">올해의 큰 흐름과 월별 분위기를 차분하게 정리해보세요</p>
</div>

<div class="card card-gradient-pink animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">🏛️</span>
    <h3>토정비결에서 주로 보는 것</h3>
  </div>
  <div class="landing-benefits">
    <div class="landing-benefit">
      <strong>한 해의 전체 분위기</strong>
      <p>올해가 정리의 해인지, 확장의 해인지, 속도를 늦춰야 하는지 큰 흐름부터 읽습니다.</p>
    </div>
    <div class="landing-benefit">
      <strong>월별 흐름 체크</strong>
      <p>중요한 달의 기세와 조심할 타이밍을 가볍게 참고용으로 볼 수 있어요.</p>
    </div>
    <div class="landing-benefit">
      <strong>연간 계획 보정</strong>
      <p>이직, 공부, 인간관계처럼 한 해를 길게 보고 판단할 때 방향을 정리하는 데 유용합니다.</p>
    </div>
  </div>
</div>

<%= render "shared/seo_cta_card",
  page_type: "tojeong_entry",
  source_section: "mid_cta",
  event_name: "landing_cta_click",
  target_tool: "tojeong",
  href: "#tojeong-entry-form",
  title: "올해 흐름이 궁금하다면 지금 시작해보세요",
  body: "생년월일시를 입력하면 무료 토정비결로 한 해 분위기와 흐름을 바로 확인할 수 있어요.",
  button_text: "무료 토정비결 입력하기" %>

<%= form_tag tojeong_path, method: :post, id: "tojeong-entry-form" do %>
  <div class="person-section animate-fadeInUp">
    <div class="form-section">
      <label class="form-label">📅 생년월일</label>
      <div class="form-row">
        <div class="form-group"><select name="year" class="form-control" required><option value="">년도</option><% (1940..2025).reverse_each do |y| %><option value="<%= y %>" <%= "selected" if y == 2000 %>><%= y %>년</option><% end %></select></div>
        <div class="form-group"><select name="month" class="form-control" required><option value="">월</option><% (1..12).each do |m| %><option value="<%= m %>"><%= m %>월</option><% end %></select></div>
        <div class="form-group"><select name="day" class="form-control" required><option value="">일</option><% (1..31).each do |d| %><option value="<%= d %>"><%= d %>일</option><% end %></select></div>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">🕐 시간</label><select name="hour" class="form-control"><option value="11" selected>오시</option><option value="0">자시</option><option value="3">인시</option><option value="7">진시</option><option value="9">사시</option><option value="13">미시</option><option value="15">신시</option><option value="17">유시</option><option value="19">술시</option><option value="21">해시</option></select></div>
      <div class="form-group"><label class="form-label">👤 성별</label><select name="gender" class="form-control"><option value="남">🙋‍♂️ 남자</option><option value="여">🙋‍♀️ 여자</option></select></div>
    </div>
  </div>
  <button type="submit" class="btn-primary mt-md" data-analytics-event="landing_cta_click" data-analytics-page-type="tojeong_entry" data-analytics-source-section="form_submit" data-analytics-target-tool="tojeong">🏛️ 토정비결 보기</button>
<% end %>

<div class="card animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">❓</span>
    <h3>무료 토정비결 FAQ</h3>
  </div>
  <div class="landing-faq-list">
    <% faqs.each do |faq| %>
      <div class="landing-faq-item">
        <strong><%= faq[:question] %></strong>
        <p><%= faq[:answer] %></p>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/public_discovery_panel", page_type: "tojeong_entry" %>

<%= render "shared/seo_cta_card",
  page_type: "tojeong_entry",
  source_section: "bottom_cta",
  event_name: "landing_cta_click",
  target_tool: "tojeong",
  href: "#tojeong-entry-form",
  title: "올해 방향을 차분하게 보고 싶다면",
  body: "무료 토정비결로 연간 분위기와 월별 흐름을 참고용으로 정리해보세요.",
  button_text: "토정비결 시작하기" %>
