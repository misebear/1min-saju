<% content_for(:title) { "사주풀이 입력 - 1분 사주" } %>

<div class="page-header animate-fadeIn">
  <!-- 가입 NO 결제 NO 초강조 배너 -->
  <div class="free-banner animate-bounce-slow" style="margin: 0 auto 16px; max-width: 320px; padding: 10px 20px; background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 100%); border-radius: 100px; color: #d61f69; font-weight: 800; font-size: 14px; box-shadow: 0 4px 15px rgba(255,154,158,0.4); border: 2px solid white;">
    💸 평생 가입 NO! 결제 NO! 100% 무료
  </div>

  <%= image_tag "snowcat/icon_cat_snowcat_1771225044956.png", class: "snowcat-mascot", alt: "1분 사주" %>
  <h1>사주풀이</h1>
  <p class="subtitle">태어난 날짜와 시간을 알려줘! 🐱</p>
</div>

<%= form_tag saju_path, method: :post, class: "animate-fadeInUp", id: "sajuForm" do %>
  <!-- 생년월일 -->
  <div class="form-section">
    <label class="form-label">📅 생년월일</label>
    <div class="form-row">
      <div class="form-group">
        <select name="year" class="form-control" required>
          <option value="">년도</option>
          <% (1940..2025).reverse_each do |y| %>
            <option value="<%= y %>" <%= 'selected' if @user_birth_date && y == @user_birth_date.year %>><%= y %>년</option>
          <% end %>
        </select>
      </div>
      <div class="form-group">
        <select name="month" class="form-control" required>
          <option value="">월</option>
          <% (1..12).each do |m| %>
            <option value="<%= m %>" <%= 'selected' if @user_birth_date && m == @user_birth_date.month %>><%= m %>월</option>
          <% end %>
        </select>
      </div>
      <div class="form-group">
        <select name="day" class="form-control" required>
          <option value="">일</option>
          <% (1..31).each do |d| %>
            <option value="<%= d %>" <%= 'selected' if @user_birth_date && d == @user_birth_date.day %>><%= d %>일</option>
          <% end %>
        </select>
      </div>
    </div>
  </div>

  <!-- 태어난 시간 -->
  <div class="form-section">
    <label class="form-label">🕐 태어난 시간</label>
    <select name="hour" class="form-control" required>
      <option value="">시간을 선택하세요</option>
      <option value="0" <%= 'selected' if @has_birth_data && @user_birth_hour == 0 %>>자시 (23:00~01:00) 🐭</option>
      <option value="1" <%= 'selected' if @has_birth_data && @user_birth_hour == 1 %>>축시 (01:00~03:00) 🐮</option>
      <option value="3" <%= 'selected' if @has_birth_data && @user_birth_hour == 3 %>>인시 (03:00~05:00) 🐯</option>
      <option value="5" <%= 'selected' if @has_birth_data && @user_birth_hour == 5 %>>묘시 (05:00~07:00) 🐰</option>
      <option value="7" <%= 'selected' if @has_birth_data && @user_birth_hour == 7 %>>진시 (07:00~09:00) 🐲</option>
      <option value="9" <%= 'selected' if @has_birth_data && @user_birth_hour == 9 %>>사시 (09:00~11:00) 🐍</option>
      <option value="11" <%= 'selected' if @has_birth_data && @user_birth_hour == 11 %>>오시 (11:00~13:00) 🐴</option>
      <option value="13" <%= 'selected' if @has_birth_data && @user_birth_hour == 13 %>>미시 (13:00~15:00) 🐑</option>
      <option value="15" <%= 'selected' if @has_birth_data && @user_birth_hour == 15 %>>신시 (15:00~17:00) 🐵</option>
      <option value="17" <%= 'selected' if @has_birth_data && @user_birth_hour == 17 %>>유시 (17:00~19:00) 🐔</option>
      <option value="19" <%= 'selected' if @has_birth_data && @user_birth_hour == 19 %>>술시 (19:00~21:00) 🐶</option>
      <option value="21" <%= 'selected' if @has_birth_data && @user_birth_hour == 21 %>>해시 (21:00~23:00) 🐷</option>
    </select>
  </div>

  <!-- 출생지 -->
  <div class="form-section">
    <label class="form-label">📍 출생지 <span class="term-note">지역 시차 + 서머타임 자동 보정에 사용돼요</span></label>
    <select name="city" class="form-control">
      <% @city_options.each do |label, key| %>
        <option value="<%= key %>" <%= 'selected' if (@has_birth_data && @user_city == key) || (!@has_birth_data && key == '서울') %>><%= label %></option>
      <% end %>
    </select>
  </div>

  <!-- 성별 -->
  <div class="form-section">
    <label class="form-label">👤 성별</label>
    <div class="gender-toggle">
      <label class="gender-btn <%= @user_gender != '여' ? 'active' : '' %>" id="gender-male" onclick="selectGender('남', this)">
        <input type="radio" name="gender" value="남" <%= 'checked' if @user_gender != '여' %>>
        🙋‍♂️ 남자
      </label>
      <label class="gender-btn <%= @user_gender == '여' ? 'active' : '' %>" id="gender-female" onclick="selectGender('여', this)">
        <input type="radio" name="gender" value="여" <%= 'checked' if @user_gender == '여' %>>
        🙋‍♀️ 여자
      </label>
    </div>
  </div>

  <div class="divider"></div>

  <button type="submit" class="btn-primary btn-pulse" id="submitBtn" style="padding: 18px 24px; font-size: 18px; font-weight: 800; letter-spacing: -0.02em;">
    👉 사주 명식 분석하기
  </button>
<% end %>

<div class="card mt-lg animate-fadeInUp">
  <div class="section-header">
    <%= image_tag "snowcat/icon_dog_snowcat_1771224888733.png", class: "snowcat-mascot snowcat-mascot-sm", alt: "사주멍이" %>
    <h3>알아두면 좋은 꿀팁!</h3>
  </div>
  <p class="text-small text-muted" style="line-height: 1.8;">
    💡 정확한 태어난 시간을 입력하면 더 정확한 사주풀이를 받을 수 있어!<br>
    📝 태어난 시간을 모르면 가장 가까운 시간대를 선택해도 괜찮아~<br>
    🌙 사주는 음양오행(나무, 불, 흙, 쇠, 물)의 조화로 너의 운명을 읽어내는 거야!
  </p>
</div>


<!-- 폼 제출 시 보여줄 오버레이 (디폴트는 숨김) -->
<div id="loading-overlay" style="display: none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(255,255,255,0.9); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
  <div style="font-size: 40px; margin-bottom: 20px;" class="animate-bounce">🔮</div>
  <h3 style="color: var(--tint); font-weight: 800; font-size: 20px; letter-spacing: -0.02em; margin-bottom: 8px;">명식을 분석하고 있어요...</h3>
  <p style="color: var(--text-3); font-size: 14px;">음양오행의 기운을 확인하는 중입니다 ✨</p>
</div>

<script>
function selectGender(value, el) {
  document.querySelectorAll('.gender-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  el.querySelector('input').checked = true;
}

document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('sajuForm');
  const overlay = document.getElementById('loading-overlay');
  
  if (form && overlay) {
    form.addEventListener('submit', function(e) {
      const btn = document.getElementById('submitBtn');
      if (btn) {
        btn.innerHTML = '⏳ 분석 중...';
        btn.style.opacity = '0.7';
        btn.style.pointerEvents = 'none';
      }
      
      // 약간의 지연 후 폼 제출되도록 (눈길 사로잡기 위함)
      overlay.style.display = 'flex';
      
      // 이미 submit 이벤트 내라서 별도 제어 없이 전송되지만, UX를 위해 화면만 덮어둠.
    });
  }
});
</script>
