<%
  faqs = [
    {
      question: "오늘의 운세는 무료로 볼 수 있나요?",
      answer: "네. 1분 사주에서는 오늘의 운세를 무료로 확인할 수 있고, 입력 후 재물운, 연애운, 건강운, 커리어 흐름까지 함께 볼 수 있습니다."
    },
    {
      question: "태어난 시간이 꼭 필요한가요?",
      answer: "태어난 시간을 알면 더 자세한 흐름을 볼 수 있지만, 모를 때도 기본적인 운세 확인은 가능합니다."
    },
    {
      question: "오늘의 운세를 본 뒤에 무엇을 더 볼 수 있나요?",
      answer: "오늘의 운세를 확인한 뒤에는 연간 운세, 무료 궁합, 사주 챗봇, 별자리 운세 같은 연결 콘텐츠로 이어서 볼 수 있습니다."
    }
  ]
%>
<% content_for(:title) { "오늘의 운세 무료 확인 | 1분 사주" } %>
<% content_for(:description) { "오늘의 운세를 무료로 확인해보세요. 생년월일시 입력 후 재물운, 연애운, 건강운, 커리어 운세까지 1분 안에 확인할 수 있습니다." } %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw faq_schema_json(faqs) %></script>
<% end %>

<div class="page-header animate-fadeIn">
  <h1>오늘의 운세 무료 확인</h1>
  <p class="subtitle"><%= Date.today.strftime("%Y년 %m월 %d일") %> 오늘의 흐름과 기분 변화를 가볍게 확인해보세요</p>
</div>

<div class="card card-gradient-pink animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">🔮</span>
    <h3>오늘의 운세는 어떻게 보나요?</h3>
  </div>
  <p style="line-height: 1.9; color: var(--text-secondary);">
    생년월일과 태어난 시간을 입력하면 오늘의 종합 운세 점수, 재물운, 연애운, 건강운, 커리어 흐름,
    행운의 색과 숫자까지 한 번에 볼 수 있어요. 검색에서 들어와도 바로 시작할 수 있게 구성했습니다.
  </p>
</div>

<div class="card animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">🍀</span>
    <h3>이 페이지에서 함께 보는 내용</h3>
  </div>
  <div class="fortune-grid">
    <div class="fortune-item"><span class="emoji">💰</span><span class="label">재물운</span><span class="value">오늘의 금전 흐름</span></div>
    <div class="fortune-item"><span class="emoji">💕</span><span class="label">연애운</span><span class="value">관계와 감정 기류</span></div>
    <div class="fortune-item"><span class="emoji">💪</span><span class="label">건강운</span><span class="value">컨디션 체크</span></div>
    <div class="fortune-item"><span class="emoji">💼</span><span class="label">커리어운</span><span class="value">일과 공부 운세</span></div>
  </div>
</div>

<%= render "shared/seo_cta_card",
  page_type: "daily_landing",
  source_section: "mid_cta",
  event_name: "landing_cta_click",
  target_tool: "saju",
  href: new_saju_path,
  title: "오늘의 운세를 바로 확인해보세요",
  body: "생년월일시 입력 후 오늘의 종합 점수와 재물·연애·건강·커리어 흐름을 바로 볼 수 있어요.",
  button_text: "오늘의 운세 바로 확인" %>

<div class="card animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">✨</span>
    <h3>이런 분께 잘 맞아요</h3>
  </div>
  <div class="seo-intent-list">
    <div class="seo-intent-item">
      <strong>오늘 운세를 빠르게 보고 싶은 분</strong>
      <p>하루 컨디션과 금전, 관계 흐름을 짧게 먼저 정리해보고 싶을 때 가장 편합니다.</p>
    </div>
    <div class="seo-intent-item">
      <strong>사주풀이와 함께 보고 싶은 분</strong>
      <p>오늘운세만 보기보다 사주 명식과 함께 읽어야 더 이해가 잘 되는 분께 잘 맞습니다.</p>
    </div>
    <div class="seo-intent-item">
      <strong>다음 메뉴까지 이어서 보고 싶은 분</strong>
      <p>오늘의 운세 뒤에 연간 운세, 무료 궁합, 챗봇으로 자연스럽게 이어서 보기 좋습니다.</p>
    </div>
  </div>
</div>

<div class="card animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">❓</span>
    <h3>오늘의 운세 FAQ</h3>
  </div>
  <div class="landing-faq-list">
    <% faqs.each do |faq| %>
      <div class="landing-faq-item">
        <strong><%= faq[:question] %></strong>
        <p><%= faq[:answer] %></p>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/public_discovery_panel", page_type: "daily_landing" %>

<%= render "shared/seo_cta_card",
  page_type: "daily_landing",
  source_section: "bottom_cta",
  event_name: "landing_cta_click",
  target_tool: "saju",
  href: new_saju_path,
  title: "오늘의 흐름을 사주 기준으로 보고 싶다면",
  body: "무료 사주풀이를 먼저 입력하면 오늘의 운세를 더 자연스럽게 이어서 확인할 수 있어요.",
  button_text: "무료 사주풀이 시작" %>
