<% if @selected_animal %>
  <% animal_name = @selected_animal[:data][:name] %>
  <% content_for(:title) { "2026년 오늘의 #{animal_name} 운세 소름 돋는 무료 사주풀이 - 1분 사주" } %>
  <% content_for(:description) { "회원가입 없이 무료로 보는 2026년 오늘 #{animal_name} 운세! 재물운, 애정운, 건강운, 직업운을 로그인 없이 1분 안에 지금 바로 확인해보세요. 나랑 똑같은 #{animal_name} 유명인은 누구?" } %>
<% else %>
  <% content_for(:title) { "띠운세 - 1분 사주" } %>
<% end %>
<div class="page-header animate-fadeIn">
  <h1><%= @selected_animal ? "#{@selected_animal[:data][:name]} 운세" : "🐲 오늘의 띠운세" %></h1>
  <p class="subtitle"><%= @selected_animal ? "오늘 나의 기운은 어떨까? 🌟" : @date.strftime("%Y년 %m월 %d일") %></p>
</div>
<% @tti_fortunes.each do |tf| %>
  <% polished_headline = polished_gemini_tti_headline(tf[:headline]) %>
  <% polished_fortune = polished_gemini_tti_text(tf[:fortune]) %>
  <% polished_lucky_point = polished_gemini_tti_lucky_point(tf[:lucky_point]) %>
  <div class="card animate-fadeInUp" style="padding:16px;">
    <div style="display:flex; align-items:center; gap:12px;">
      <div style="font-size:36px;"><%= tf[:data][:emoji] %></div>
      <div style="flex:1;">
        <div style="font-weight:800; font-size:16px;"><%= tf[:data][:name] %></div>
        <div style="font-size:11px; color:var(--text-3);"><%= tf[:data][:years] %></div>
      </div>
      <div style="font-weight:900; font-size:18px; color:var(--primary);"><%= tf[:score] %>점</div>
    </div>
    <% if polished_headline.present? %>
      <div style="margin-top:10px;">
        <span style="display:inline-block; padding:4px 10px; border-radius:999px; background:#ec489920; color:#ec4899; font-size:12px; font-weight:700;"><%= polished_headline %></span>
      </div>
    <% end %>
    <p style="font-size:13px; color:var(--text-2); margin-top:8px; line-height:1.6;"><%= polished_fortune %></p>
    <% if polished_lucky_point.present? %>
      <p style="font-size:12px; color:var(--primary); margin-top:8px; font-weight:700;">행운 포인트: <%= polished_lucky_point %></p>
    <% end %>
  </div>
<% end %>
