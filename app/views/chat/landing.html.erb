<%
  faqs = [
    {
      question: "사주 챗봇에서는 무엇을 물어볼 수 있나요?",
      answer: "오늘의 운세, 연애운, 재물운, 커리어, 성격 흐름처럼 사주를 바탕으로 한 질문을 자연스럽게 이어서 물어볼 수 있습니다."
    },
    {
      question: "사주를 먼저 입력해야 하나요?",
      answer: "더 정확한 답변을 위해서는 생년월일시를 먼저 입력하는 것이 좋지만, 페이지 구조와 기능 설명은 누구나 확인할 수 있습니다."
    },
    {
      question: "챗봇 다음에는 무엇을 같이 보면 좋나요?",
      answer: "사주 챗봇과 함께 오늘의 운세, 무료 궁합, 연간 운세를 같이 보면 전체 흐름을 이해하는 데 도움이 됩니다."
    }
  ]
%>
<% content_for(:title) { "사주 챗봇 무료 질문 | 1분 사주" } %>
<% content_for(:description) { "사주 챗봇에서 오늘의 운세, 연애운, 재물운, 커리어, 성격 흐름을 무료로 질문해보세요. 먼저 사주를 입력하면 더 정확한 대화를 이어갈 수 있습니다." } %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw faq_schema_json(faqs) %></script>
<% end %>

<div class="page-header animate-fadeIn">
  <%= image_tag "snowcat/icon_cat_snowcat_1771225044956.png", class: "snowcat-mascot", alt: "1분 사주" %>
  <h1>사주 챗봇 무료 질문</h1>
  <p class="subtitle">사주를 바탕으로 오늘운세, 연애운, 재물운, 커리어를 자연스럽게 질문하는 공간</p>
</div>

<div class="card animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">💬</span>
    <h3>무엇을 물어볼 수 있나요?</h3>
  </div>
  <div class="fortune-grid">
    <div class="fortune-item"><span class="emoji">🔮</span><span class="label">오늘의 운세</span><span class="value">오늘의 기운 요약</span></div>
    <div class="fortune-item"><span class="emoji">💕</span><span class="label">연애운</span><span class="value">관계와 감정 흐름</span></div>
    <div class="fortune-item"><span class="emoji">💰</span><span class="label">재물운</span><span class="value">돈과 소비 방향</span></div>
    <div class="fortune-item"><span class="emoji">💼</span><span class="label">커리어</span><span class="value">일과 진로 고민</span></div>
  </div>
</div>

<%= render "shared/seo_cta_card",
  page_type: "chat_landing",
  source_section: "mid_cta",
  event_name: "landing_cta_click",
  target_tool: "saju",
  href: new_saju_path,
  title: "사주 입력 후 챗봇을 더 정확하게 써보세요",
  body: "먼저 생년월일시를 입력하면 내 명식 기준으로 질문을 이어갈 수 있어 답변 맥락이 더 자연스럽습니다.",
  button_text: "사주 입력하고 챗봇 열기" %>

<div class="card card-gradient-pink animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">🐱</span>
    <h3>이런 분께 잘 맞아요</h3>
  </div>
  <div class="seo-intent-list">
    <div class="seo-intent-item">
      <strong>짧게 궁금한 것만 묻고 싶은 분</strong>
      <p>오늘운세 전체 결과를 길게 보기보다 지금 궁금한 포인트만 바로 묻고 싶은 경우에 편합니다.</p>
    </div>
    <div class="seo-intent-item">
      <strong>연애와 재물 흐름을 따로 보고 싶은 분</strong>
      <p>사주 전체보다 특정 주제를 중심으로 대화를 이어가며 확인하고 싶은 분께 잘 맞습니다.</p>
    </div>
    <div class="seo-intent-item">
      <strong>오늘운세 뒤에 더 깊게 질문하고 싶은 분</strong>
      <p>오늘의 운세나 연간 운세를 먼저 보고, 챗봇에서 세부 질문으로 이어가기에 좋은 구조입니다.</p>
    </div>
  </div>
</div>

<div class="card animate-fadeInUp">
  <div class="section-header">
    <span class="emoji">❓</span>
    <h3>사주 챗봇 FAQ</h3>
  </div>
  <div class="landing-faq-list">
    <% faqs.each do |faq| %>
      <div class="landing-faq-item">
        <strong><%= faq[:question] %></strong>
        <p><%= faq[:answer] %></p>
      </div>
    <% end %>
  </div>
</div>

<%= render "shared/public_discovery_panel", page_type: "chat_landing" %>

<%= render "shared/seo_cta_card",
  page_type: "chat_landing",
  source_section: "bottom_cta",
  event_name: "landing_cta_click",
  target_tool: "saju",
  href: new_saju_path,
  title: "챗봇을 더 제대로 쓰고 싶다면",
  body: "생년월일시 입력 뒤 오늘의 운세, 연간 운세, 궁합과 함께 챗봇을 이어서 써보는 흐름이 가장 자연스럽습니다.",
  button_text: "무료 사주풀이 먼저 시작" %>
