<% # 공통 푸터 파셜 - SNS 공유 + 앱 정보 %>
<div class="shared-footer" style="margin-top: 32px; padding: 20px 0; text-align: center;">
  <div style="margin-bottom: 16px;">
    <a href="<%= root_path %>" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text-2, #888);">
      <%= image_tag "logo_1min_saju.png", style: "width: 24px; height: 24px; border-radius: 6px;", alt: "1분 사주" %>
      <span style="font-size: 13px; font-weight: 600;">1분 사주</span>
    </a>
  </div>
  <div style="margin-bottom: 12px; font-size: 11px; color: var(--text-3, #888); display: flex; justify-content: center; gap: 12px;">
    <span>오늘 방문: <strong><%= number_with_delimiter(@today_visitors || 0) %></strong></span>
    <span>누적 방문: <strong><%= number_with_delimiter(@total_visitors || 0) %></strong></span>
  </div>

  <p style="font-size: 11px; color: var(--text-3, #666); line-height: 1.8;">
    사주 결과는 참고용이에요~ 너의 노력이 제일 중요해! 🐶<br>
    © 2026 1분 사주 ✨
  </p>
</div>
