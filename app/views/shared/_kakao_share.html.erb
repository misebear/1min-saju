<% # 공통 카카오톡 공유 버튼 파셜 %>
<% # 사용법: render partial: "shared/kakao_share", locals: { title: "제목", description: "설명", path: request.path } %>
<div class="kakao-share-wrap" style="text-align: center; margin-top: 16px;">
  <button onclick="shareKakao()" class="action-btn" style="background: #FEE500; color: #3C1E1E; border: none; padding: 12px 28px; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
    💬 카카오톡으로 공유
  </button>
</div>

<script>
function shareKakao() {
  if (typeof Kakao === 'undefined') { alert('카카오 SDK 로딩 중이에요!'); return; }
  if (!Kakao.isInitialized()) {
    // 카카오 앱 키 (필요 시 환경변수로)
    try { Kakao.init('<%= ENV["KAKAO_JS_KEY"] || "" %>'); } catch(e) {}
  }
  Kakao.Share.sendDefault({
    objectType: 'feed',
    content: {
      title: '<%= local_assigns[:title] || "1분 사주 결과" %>',
      description: '<%= local_assigns[:description] || "나만의 사주풀이 결과를 확인해보세요! ✨" %>',
      imageUrl: window.location.origin + '/icon-512.png',
      link: {
        mobileWebUrl: window.location.origin + '<%= local_assigns[:path] || "/" %>',
        webUrl: window.location.origin + '<%= local_assigns[:path] || "/" %>'
      }
    },
    buttons: [{
      title: '나도 해보기',
      link: {
        mobileWebUrl: window.location.origin + '/',
        webUrl: window.location.origin + '/'
      }
    }]
  });
}
</script>
